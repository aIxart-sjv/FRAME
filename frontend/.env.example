# VITE_FRAME_API_URL: base URL of the running FRAME backend (frame/api, FastAPI).
# Defaults to http://127.0.0.1:8000 if unset -- the backend's own default port
# (see frame/api/README.md). The backend's CORS allow-list must include this
# frontend's origin (its default already includes http://localhost:3000).
VITE_FRAME_API_URL="http://127.0.0.1:8000"
